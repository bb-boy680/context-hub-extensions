{
  "format": 1,
  "title": {
    "en": "Context Hub Extensions",
    "zh-cn": "Context Hub 扩展"
  },
  "description": {
    "en": "First-party extensions for Context Hub.",
    "zh-cn": "Context Hub 的第一方扩展。"
  },
  "plugins": [
    {
      "id": "claude.code",
      "title": {
        "en": "Claude Code",
        "zh-cn": "Claude Code"
      },
      "description": {
        "en": "Deliver skills, memory and MCP servers to Claude Code.",
        "zh-cn": "将技能、记忆和 MCP 服务器交付给 Claude Code。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "Context Hub",
      "category": "agent",
      "permissions": [
        "assets.read",
        "assets.write",
        "filesystem"
      ],
      "versions": [
        {
          "version": "0.1.0",
          "apiVersion": "^0.1",
          "source": {
            "type": "git",
            "url": "https://github.com/bb-boy680/context-hub-extensions",
            "path": "plugins/claude.code"
          }
        }
      ]
    },
    {
      "id": "skills.sh",
      "title": {
        "en": "skills.sh",
        "zh-cn": "skills.sh"
